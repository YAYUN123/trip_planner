# AMap Web JS API key
# Get it from: https://console.amap.com/dev/key/app
VITE_AMAP_KEY=your-amap-api-key

# Optional: AMap security code. Needed for accounts that require security config.
VITE_AMAP_SECURITY_JS_CODE=your-amap-security-js-code

# Optional: custom security proxy host if you use one.
# VITE_AMAP_SERVICE_HOST=/_AMapService

# Backend API base URL (optional, dev server proxy is used by default)
VITE_API_BASE_URL=http://localhost:8000